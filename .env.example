# Environment template for ygocards-service.
#
# WHO READS THIS FILE. Spring Boot does not. It loads application.properties, and the
# ${VAR:default} entries there read process environment variables. This file only becomes
# effective when something exports its contents into the environment first:
#
#   scripts/start.sh   sources it and exports every key before launching the JVM
#   scripts/start.ps1  parses it and sets the variables for the child process
#   docker run         --env-file .env  (once the image exists)
#
# Running "java -jar target/ygocards-service.jar" by hand ignores this file completely and
# uses the defaults compiled into application.properties. That is deliberate: the defaults
# make the service runnable on a clean machine with nothing configured.
#
# Copy to .env and edit. The copy is git-ignored; this template is committed. Neither one
# holds a secret, because the upstream API needs no credential.

# --- Port binding -------------------------------------------------------------------------
PORT=8080

# --- Disposability ------------------------------------------------------------------------
# How long in-flight requests may take to finish after a termination signal.
SHUTDOWN_TIMEOUT=20s

# --- Logging ------------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Upstream card API, attached as a backing service ---------------------------------------
# Point these somewhere else to run against a mirror, a proxy or a local stub, with no rebuild.
YGO_API_BASE_URL=https://db.ygoprodeck.com/api/v7
YGO_IMAGE_BASE_URL=https://images.ygoprodeck.com/images

# Cheap request used to decide whether the upstream answers at all.
YGO_PROBE_PATH=/checkDBVer.php

# How long a probe result stays usable. Stops health polling from spending the request budget.
UPSTREAM_PROBE_TTL=30s

# Two separate outbound budgets, not one shared counter. One search produces one upstream call;
# the page it returns then asks for one image per card, so the classes stand at roughly 1 to 24.
# A shared counter guarantees that images crowd out searches.
#
# A search was requested by a person who is waiting, so it needs a small budget that is reliably
# there and a short wait. An image is derived, idempotent, cacheable for an hour, and one missing
# image degrades one card out of a page, so it can afford to wait much longer.
#
# The sum is 12 against the provider ceiling of 20, leaving 40 percent of headroom, because going
# over costs an hour of being blocked.
YGO_RATE_LIMIT_SEARCH_PER_SECOND=3
YGO_RATE_LIMIT_SEARCH_WAIT=750ms
YGO_RATE_LIMIT_IMAGE_PER_SECOND=9
YGO_RATE_LIMIT_IMAGE_WAIT=4s

YGO_CONNECT_TIMEOUT=3s
YGO_READ_TIMEOUT=5s

# --- Bounded in-memory caches ---------------------------------------------------------------
# Both a time to live and an entry ceiling, so a long-running process cannot grow without limit.
CACHE_CARD_TTL=15m
CACHE_CARD_MAX_ENTRIES=500
CACHE_IMAGE_TTL=1h
CACHE_IMAGE_MAX_ENTRIES=200
